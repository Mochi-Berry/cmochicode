{
  "name": "cmochicode",
  "version": "0.1.0",
  "description": "JS -> C99 transpiler for MochiBerry: lex/parse/IR/emit pipeline, readable native C, borrows the host GC allocator, no bytecode.",
  "main": "./node_modules/src/index.js",
  "exports": {
    ".": "./node_modules/src/index.js",
    "./manifest": "./manifest.json"
  },
  "bin": {
    "cmochicode": "src/index.js"
  },
  "scripts": {
    "module": "make module",
    "test": "bash tests/run.sh"
  },
  "dependencies": {
    "acorn": "^8.11.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {},
  "license": "MIT"
}
